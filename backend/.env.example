# ============================================================
# Anti-Theft Smart System — Production Environment Configuration
# Copy to .env and fill in all values before deployment.
# ============================================================

# Environment — set to "production" to enforce strict security checks
ENV=production

# Database
POSTGRES_USER=farm_user
POSTGRES_PASSWORD=<GENERATE: openssl rand -hex 16>
POSTGRES_DB=farm_surveillance
DATABASE_URL=postgresql://farm_user:<SAME_PASSWORD>@postgres:5432/farm_surveillance

# MQTT — credentials must match mosquitto/passwd (run setup_mqtt_auth.sh first)
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=backend_svc
MQTT_PASSWORD=<FROM: mosquitto/credentials/backend.env>

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=<GENERATE: openssl rand -hex 16>
MINIO_SECRET_KEY=<GENERATE: openssl rand -hex 32>
MINIO_BUCKET=alert-snapshots
MINIO_SECURE=false

# JWT — REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=<REQUIRED>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Firebase Cloud Messaging
FIREBASE_CREDENTIALS_PATH=firebase-admin-key.json

# Server
HOST=0.0.0.0
PORT=8000

# CORS — comma-separated allowed origins (mobile app, admin dashboard)
# Example: https://api.farmguard.in,https://admin.farmguard.in
CORS_ORIGINS=
