# Database
DATABASE_URL=postgresql://atss:atss_secret@localhost:5432/atss

# MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=alert-snapshots
MINIO_SECURE=false

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Firebase (optional — leave empty to use console logging)
FIREBASE_CREDENTIALS_PATH=

# Server
HOST=0.0.0.0
PORT=8000
